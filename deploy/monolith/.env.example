# Monolith 서버 환경변수

# Docker Hub 계정 (이미지 pull에 필요)
DOCKER_USERNAME=your_dockerhub_username

# MySQL 설정
MYSQL_ROOT_PASSWORD=secure_password_here

# JWT 시크릿 (QR Service와 동일해야 함)
JWT_SECRET=your_jwt_secret_here

# 내부 서비스 통신 토큰 (QR Service와 동일해야 함)
INTERNAL_AUTH_TOKEN=your_internal_token_here

# 프론트엔드 URL (CORS, 리다이렉트용)
FE_BASE_URL=http://localhost:3030

# QR Service 연동 URL (monolith → qr webhook/REST)
# ⚠️ 미설정 시 application-prod.yml 기본값으로 떨어지는데, 그 호스트명은 monolith EC2에서 resolve 안 됨 → 캐시 동기화 전부 실패
# qr-service는 8081에서 listen. 반드시 qr EC2의 Private IP로 설정할 것.
QR_SERVICE_URL=http://10.0.1.101:8081

# Store/Menu 변경 webhook 발송 on/off
QR_WEBHOOK_ENABLED=true
