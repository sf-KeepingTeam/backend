# =============================================================================
# Monolith EC2 환경변수
# =============================================================================

# Docker 이미지 태그 접두어.
# Docker Hub를 쓰지 않고 EC2에서 직접 빌드하는 경우에도 이 값으로 태그를 붙인다.
#   docker build -t keeping/keeping-monolith:latest ./monolith
# → 로컬에 같은 태그가 있으면 compose가 pull 없이 그대로 사용한다.
DOCKER_USERNAME=keeping

# -----------------------------------------------------------------------------
# 데이터베이스
# -----------------------------------------------------------------------------
MYSQL_ROOT_PASSWORD=change_me

# -----------------------------------------------------------------------------
# 인증/보안
# -----------------------------------------------------------------------------
# ⚠️ QR Service와 반드시 동일한 값 (qr가 monolith 발급 JWT를 그대로 검증한다)
#    생성: openssl rand -base64 64
JWT_SECRET=change_me

# ⚠️ QR Service와 동일한 값. 기본값(internal-service-token-12345) 그대로 두지 말 것.
INTERNAL_AUTH_TOKEN=change_me

FE_BASE_URL=http://localhost:3030

# -----------------------------------------------------------------------------
# QR Service 연동
# -----------------------------------------------------------------------------
# ⚠️ 반드시 qr EC2의 Private IP:8081.
#    미설정 시 application-prod.yml 기본값(http://qr-service:8081)으로 떨어지는데
#    호스트명 qr-service는 2-EC2 환경에서 resolve되지 않는다
#    → monolith→qr webhook(Store/Menu 캐시 동기화)이 전부 실패한다.
QR_SERVICE_URL=http://10.0.2.100:8081
QR_WEBHOOK_ENABLED=true

# -----------------------------------------------------------------------------
# 부하테스트 (⚠️ 측정 종료 후 반드시 원복하고 그 사실을 기록에 남길 것)
# -----------------------------------------------------------------------------
# 운영:  SPRING_PROFILES_ACTIVE=prod         / LOADTEST_BACKDOOR_ENABLED=false
# 측정:  SPRING_PROFILES_ACTIVE=prod,loadtest / LOADTEST_BACKDOOR_ENABLED=true
#
# loadtest 프로필은 백도어와 별개로 로그 레벨을 WARN으로 낮춘다.
# 측정 중 로그 I/O가 지표에 섞이지 않게 하려면 이 프로필을 같이 켜는 편이 낫다.
SPRING_PROFILES_ACTIVE=prod
LOADTEST_BACKDOOR_ENABLED=false

# -----------------------------------------------------------------------------
# 측정 통제변인 (한 번에 하나만 바꿀 것)
# -----------------------------------------------------------------------------
# 톰캣 스레드: 200(기본) / 20(스레드풀 포화 강제)
#   적용 확인 → curl localhost:8080/actuator/metrics/tomcat.threads.config.max
SERVER_TOMCAT_THREADS_MAX=200

# Hikari 풀: 20(현행, application-prod.yml 하드코딩값) / 60(확대)
#   적용 확인 → curl localhost:8080/actuator/metrics/hikaricp.connections.max
SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE=20

# 스키마 생성이 필요한 최초 1회만 update, 그 뒤 validate로 되돌릴 것
SPRING_JPA_HIBERNATE_DDL_AUTO=validate

# ── JDBC 드라이버 세션상태 로컬 캐시 (인프라 단독 실험 · 2026-08-25) ──────────
#   false = mysql-connector-j 기본값. 지금까지의 모든 측정이 이 값이었다.
#   true  = 드라이버가 autocommit/tx-isolation 상태를 자기가 기억하고
#           서버로 보내던 `SET autocommit = ?` 왕복을 생략한다.
#
#   근거: DIAG-A1 digest 에서 `SET autocommit = ?` 120,485회 · 18.4초 (6.0 %).
#         COMMIT 60,229회 × 2 = 트랜잭션마다 off/on 왕복.
#
#   ⚠️ 드라이버가 세션 상태를 잘못 기억하면 트랜잭션 경계가 어긋날 수 있다.
#      반드시 (1) 기능 게이트 먼저 (2) 캐싱·인덱스와 섞지 말고 단독으로
#      (3) 효과 없으면 false 로 되돌린다.
#   ⚠️ 구성1 vs 구성2 비교 시 양쪽 값을 같게 맞출 것. 통제변인이다.
USE_LOCAL_SESSION_STATE=false

# ---------------------------------------------------------------------
# 정적 참조 데이터 캐싱 (monolith) — none | caffeine | redis
#   none     기본값. NoOpCacheManager = 캐싱 없음 = 기존 러닝과 동일 조건
#   caffeine 프로세스 내 인메모리. 직렬화 없음
#   redis    분산. JPA 엔티티 직렬화 검증 후 사용할 것
#   ⚠️ 바꾼 뒤 컨테이너 안을 확인해라: docker exec keeping-monolith env | grep CACHE_PROVIDER
#      그리고 기동 로그의  [Cache] provider=...  를 볼 것
# ---------------------------------------------------------------------
CACHE_PROVIDER=none
