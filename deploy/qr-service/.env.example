# =============================================================================
# QR Service EC2 환경변수
# =============================================================================

# EC2에서 직접 빌드하는 경우에도 이 태그로 빌드하면 compose가 로컬 이미지를 쓴다:
#   docker build -t keeping/keeping-qr-service:latest ./qr-service
DOCKER_USERNAME=keeping

MYSQL_ROOT_PASSWORD=change_me

# ⚠️ Monolith와 반드시 동일한 값
JWT_SECRET=change_me
INTERNAL_AUTH_TOKEN=change_me

# ⚠️ monolith EC2의 Private IP (ACL 호출용)
MONOLITH_HOST=10.0.1.100

# -----------------------------------------------------------------------------
# 캐시 모드 — 측정 구성 B/C를 가르는 변수
#   NONE          → 구성 B (Store/Menu를 매번 monolith에 조회)
#   WRITE_THROUGH → 구성 C (현재 구조)
# 값을 바꾼 뒤: docker compose up -d --no-deps qr-service
# WRITE_THROUGH로 전환한 직후에는 캐시 워밍에 ~30초를 준 다음 측정을 시작할 것.
# -----------------------------------------------------------------------------
CACHE_MODE=WRITE_THROUGH
CACHE_WARMING_ENABLED=true

# -----------------------------------------------------------------------------
# 부하테스트 (⚠️ 측정 종료 후 false로 원복)
# -----------------------------------------------------------------------------
LOADTEST_BACKDOOR_ENABLED=false
SPRING_PROFILES_ACTIVE=docker

# -----------------------------------------------------------------------------
# 측정 통제변인
# -----------------------------------------------------------------------------
SERVER_TOMCAT_THREADS_MAX=200
HIKARI_MAX_POOL_SIZE=15
