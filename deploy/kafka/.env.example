# Kafka (keeping-allinone)

# ★ 다른 EC2 에서 붙는다. 반드시 allinone 의 Private IP.
#   localhost/컨테이너명으로 두면 원격 프로듀서가 메타데이터를 받고도 접속에 실패한다.
KAFKA_ADVERTISED_HOST=172.31.39.211

# KRaft 클러스터 ID (base64 UUID 22자). 최초 1회 생성 후 고정.
#   재생성: docker run --rm apache/kafka:3.9.0 /opt/kafka/bin/kafka-storage.sh random-uuid
#   ⚠️ 이미 데이터가 있는 볼륨에 다른 ID 를 주면 기동이 실패한다.
KAFKA_CLUSTER_ID=z9mCfOoOR3qmqCOFnes3pw

# 로그 보존 (시간). 기본 7일.
KAFKA_LOG_RETENTION_HOURS=168
