# Nginx 환경변수 (monolith EC2 / qr EC2 양쪽에서 동일한 파일 사용)

# 두 EC2의 Private IP (퍼블릭 IP 아님!)
MONOLITH_HOST=10.0.1.100
QR_SERVICE_HOST=10.0.2.100

# ---------------------------------------------------------------------------
# Rate limiting
# ---------------------------------------------------------------------------
# 운영 기본값 (gateway/nginx.conf 와 동일):
#   RATE_LIMIT_QR=30r/s
#   RATE_LIMIT_GENERAL=100r/s
#
# ⚠️ 부하측정 러닝에서는 아래처럼 상향할 것.
#    limit_req_zone의 키가 클라이언트 IP($binary_remote_addr)인데
#    k6는 loadgen EC2 1대에서 나가므로 모든 VU가 IP 하나를 공유한다.
#    운영값 그대로면 Nginx가 초과분을 429로 쳐내고 monolith는 부하를 받지 못한다
#    → "포화되지 않았다"는 가짜 결론이 나온다 (v1 측정 실패의 유력한 원인).
#    측정 시 이 값을 올렸다는 사실을 result.md 에 반드시 기록할 것.
#
# 측정용:
#   RATE_LIMIT_QR=100000r/s
#   RATE_LIMIT_GENERAL=100000r/s
#   RATE_BURST_QR=100000
#   RATE_BURST_GENERAL=100000
RATE_LIMIT_QR=30r/s
RATE_LIMIT_GENERAL=100r/s
RATE_BURST_QR=50
RATE_BURST_GENERAL=200
