# =============================================================================
# 부하측정용 Prometheus (loadgen EC2에서 실행)
# =============================================================================
# 기존 monitoring/prometheus.yml 은 docker-compose.msa.yml(단일 호스트) 전용이고
# 타겟이 컨테이너 이름(monolith:8080 / qr-service:8082)이라 여기서는 못 쓴다.
#
# 구성 1(합침)과 구성 2(나눔)를 둘 다 등록해 둔다.
# 안 돌고 있는 쪽은 target down 으로 표시될 뿐 해가 없고,
# 구성을 전환할 때마다 설정을 고칠 필요가 없어진다.
#
#   setup="config1"  → keeping-allinone (합침)
#   setup="config2"  → keeping-main + keeping-payment (나눔)
#
# envsubst 변수: ALLINONE_HOST, MONOLITH_HOST, QR_SERVICE_HOST, KAFKA_HOST (전부 Private IP)

global:
  # 5초. 15초로는 hikaricp_connections_pending 같은 지표의 순간 피크를 놓친다.
  # 그러면 "DB 경합이 없었다"는 잘못된 결론이 나온다.
  scrape_interval: 5s
  scrape_timeout: 4s

scrape_configs:
  # ── 구성 1 (합침) — 한 서버에 monolith + qr-service ──────────────────────
  - job_name: 'config1-monolith'
    metrics_path: '/actuator/prometheus'
    static_configs:
      - targets: ['${ALLINONE_HOST}:8080']
        labels: { setup: config1, service: monolith }

  - job_name: 'config1-qr-service'
    metrics_path: '/actuator/prometheus'
    static_configs:
      - targets: ['${ALLINONE_HOST}:8081']
        labels: { setup: config1, service: qr-service }

  # ── 구성 2 (나눔) — main + payment ───────────────────────────────────────
  - job_name: 'config2-monolith'
    metrics_path: '/actuator/prometheus'
    static_configs:
      - targets: ['${MONOLITH_HOST}:8080']
        labels: { setup: config2, service: monolith }

  - job_name: 'config2-qr-service'
    metrics_path: '/actuator/prometheus'
    static_configs:
      - targets: ['${QR_SERVICE_HOST}:8081']   # 8082 아님
        labels: { setup: config2, service: qr-service }

  # ── Kafka (keeping-allinone) ─────────────────────────────────────────────
  #  kafka-exporter 는 JMX 가 아니라 Kafka 프로토콜로 붙는다.
  #  가장 중요한 지표는 컨슈머 랙 — 이벤트 기반 전환에서 "밀리고 있나"의 답이다.
  #    kafka_consumergroup_lag{consumergroup,topic,partition}
  #    kafka_topic_partition_current_offset{topic,partition}
  #    kafka_brokers
  #
  #  Kafka 를 아직 안 띄웠으면 target down 으로 표시될 뿐 해가 없다.
  - job_name: 'kafka'
    static_configs:
      - targets: ['${KAFKA_HOST}:9308']
        labels: { setup: kafka, service: kafka }

  # -- MySQL (mysqld_exporter) ---------------------------------------------
  #  측정 내내 병목은 monolith 의 DB 였는데, MySQL 이 그 시간에 무엇을 하고
  #  있었는지는 못 봤다(result.md 최대 공백). 이 두 타겟이 그 답을 준다.
  #
  #  monolith 와 qr-service 를 나란히 등록하는 이유는 대조군이다.
  #  같은 부하에서 monolith DB 만 힘들고 qr DB 는 한가하다면
  #  "병목이 monolith DB" 라는 주장이 훨씬 단단해진다.
  #
  #  주요 지표
  #    mysql_global_status_innodb_row_lock_waits        락 대기 횟수
  #    mysql_global_status_innodb_row_lock_time_avg     평균 락 대기 ms
  #    mysql_global_status_slow_queries                 슬로우 쿼리
  #    mysql_global_status_threads_running              실제로 도는 스레드
  #    mysql_global_status_innodb_buffer_pool_reads     버퍼풀 미스(디스크 read)
  #    mysql_global_status_innodb_data_fsyncs           커밋 fsync
  - job_name: 'mysql'
    static_configs:
      - targets: ['${MONOLITH_HOST}:9104']
        labels: { setup: config2, service: monolith-db }
      - targets: ['${QR_SERVICE_HOST}:9104']
        labels: { setup: config2, service: qr-db }
      - targets: ['${ALLINONE_HOST}:9104']
        labels: { setup: config1, service: allinone-db }

  - job_name: 'prometheus'
    static_configs:
      - targets: ['localhost:9090']
